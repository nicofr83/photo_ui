# photo_ui — configuration du serveur.
# AUCUN chemin en dur dans le code : le backend est déplaçable.

PHOTO_UI_HOST=127.0.0.1
PHOTO_UI_PORT=4310

DATABASE_URL=postgres://nico:Funiculi@localhost:5432/photo_ui
# La suite d'intégration REFUSE de tourner ailleurs que sur photo_ui_test.
DATABASE_URL_TEST=postgres://nico:Funiculi@localhost:5432/photo_ui_test

# --- racines EN LECTURE. Jamais écrites, caches compris.
ORIGINALS_ROOT=/Volumes/OWC Envoy Ultra/Pictures/lightroom/originals
THUMBS_ROOT=/Volumes/OWC Envoy Ultra/Pictures/lightroom/work/content-thumbs
PIPELINE_DB_ROOT=/Volumes/OWC Envoy Ultra/Pictures/lightroom/work
PAGES_ROOT=/Users/nico/projects/adobe_mcp/docs/pages
ANNOTATIONS_DIR=/Users/nico/projects/adobe_mcp/data/annotations
# Le dump FrontPage du site personnel — docs/spike-dhash-galeries.md. Lu
# seulement : le hash "moyenne de surface" est recalculé ici, jamais écrit
# dans le pipeline (contrairement à ce que recommandait le spike).
WEB_GALLERY_ROOT=/Volumes/OWC Envoy Ultra/nico/disk1_2tb/mbp16/web/cuva-old
# Les 5 pages du site lues en place (V1.7) — copie identique du site sous
# WEB_GALLERY_ROOT ci-dessus, mais un chemin DISTINCT : celui-ci est un
# sous-répertoire local d'adobe_mcp, jamais le volume externe.
WEB_SITE_ROOT=/Users/nico/projects/adobe_mcp/docs/web_site

# --- racines EN ÉCRITURE, sur le DISQUE INTERNE.
RENDER_CACHE_ROOT=/Users/nico/Library/Application Support/photo_ui/render-cache
TASKS_ROOT=/Users/nico/Documents/photo_ui/tasks

# --- le périmètre est un PARAMÈTRE, pas une constante du code.
PERIOD_FROM=1998-01-01
PERIOD_TO=2004-12-31
PERIMETER_SETS=1998-1999,2000-2001,2002,2003,2004

RENDER_EDGE=1400
# Mesuré : 59 ms en séquentiel, 19 ms à 8 en parallèle. Facteur 3.
RENDER_CONCURRENCY=8

# Le SEUL chemin d'écriture vers adobe_mcp. Désactivé par défaut.
FEATURE_DATING_EXPORT=false

LOG_LEVEL=info
